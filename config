{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "battery", "custom/power"],

    // --- WORKSPACES ---
	"hyprland/workspaces": {
	     "format": "{icon}",
	     "on-scroll-up": "hyprctl dispatch workspace e+1",
	     "on-scroll-down": "hyprctl dispatch workspace e-1"
	},

    // --- CLOCK ---
    "clock": {
        "format": "  {:%H:%M   %e %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // --- AUDIO (With Click-to-Switch) ---
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        // Left click cycles output (Speaker <-> Headphones)
        "on-click": "~/.config/waybar/scripts/switch_audio.sh", 
        // Right click opens the full mixer control
        "on-click-right": "pavucontrol" 
    },

// --- BLUETOOTH ---
    "bluetooth": {
        "format": " {status}",
        "format-disabled": "󰂲 Off", // an empty format will hide the module
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    // --- NETWORK ---
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Connected",
        "format-disconnected": "⚠  Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
	"on-click": "alacritty --class floating_nmtui -e nmtui-connect"
    },

    // --- BATTERY ---
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    // --- POWER BUTTON ---
    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "wlogout --protocol layer-shell"
    }
}
